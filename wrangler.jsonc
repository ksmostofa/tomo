{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tomo",
  "pages_build_output_dir": "./dist/client",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "tomo-memoria-evidence"
    }
  ]
}
