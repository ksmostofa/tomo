# Copy to .dev.vars for local Cloudflare development. Never commit real values.
DASHSCOPE_API_KEY=
# Tokyo Model Studio URL: https://{WorkspaceId}.ap-northeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
QWEN_CHAT_MODEL=qwen3.6-flash
QWEN_EMBEDDING_MODEL=text-embedding-v4

# Optional caregiver email delivery through Resend.
RESEND_API_KEY=
EMAIL_FROM=TOMO <alerts@example.com>
CAREGIVER_EMAIL=
